{
  "name": "financially-api",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "https://github.com/jzrreal/financially-api.git",
  "author": "Jezriel Lukas L <120305629+jzrreal@users.noreply.github.com>",
  "license": "MIT",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "lint": "./node_modules/.bin/eslint src/",
    "lint-fix": "./node_modules/.bin/eslint src/ --fix",
    "start": "node index.js",
    "build": "cp -n .env.default .env",
    "dev": "yarn lint && cross-env NODE_ENV=development nodemon index.js",
    "barbar": "cross-env NODE_ENV=development nodemon index.js",
    "test": "./scripts/run-tests.sh",
    "test:file": "./scripts/run-tests.sh",
    "test:api": "./tests/run-tests.sh",
    "test:api:file": "./tests/run-tests.sh"
  },
  "nodemonConfig": {
    "ignore": [
      "tmp/*",
      "bin/google-booking/data/*"
    ]
  },
  "jest": {
    "verbose": true,
    "testEnvironment": "node",
    "maxWorkers": 2,
    "transformIgnorePatterns": [
      "node_modules/(?!twilio)"
    ],
    "moduleNameMapper": {
      "^twilio$": "<rootDir>/src/__test__/__mocks__/twilio.js",
      "^node:events$": "<rootDir>/src/__test__/__mocks__/node-events-shim.js",
      "^node:process$": "<rootDir>/src/__test__/__mocks__/node-process-shim.js",
      "^node:util$": "<rootDir>/src/__test__/__mocks__/node-util-shim.js"
    },
    "reporters": [
      "default",
      "./node_modules/jest-html-reporter"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/__test__/setup.js"
    ],
    "globalSetup": "<rootDir>/src/__test__/global.setup.js",
    "globalTeardown": "<rootDir>/src/__test__/global.teardown.js"
  },
  "jest-html-reporter": {
    "pageTitle": "Financially Test Results",
    "outputPath": "test-reports/test-reporter.html",
    "includeFailureMsg": true,
    "executionMode": "reporter"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^14.0.0",
    "@sentry/node": "^10.25.0",
    "async-redis": "^2.0.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "file-type": "^21.1.0",
    "fs-extra": "^11.3.2",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.1.1",
    "koa-body": "^7.0.0",
    "koa-convert": "^2.0.0",
    "koa-json": "^2.0.2",
    "koa-lusca": "^2.2.0",
    "koa-pino-logger": "^5.0.0",
    "koa-router": "^14.0.0",
    "mailgun-js-sdk": "^1.2.2",
    "moment-timezone": "^0.6.0",
    "mongoose": "^9.6.2",
    "mongoose-delete": "^1.0.7",
    "mongoose-paginate-v2": "^1.9.4",
    "pino": "^10.1.0",
    "url-join": "^5.0.0"
  },
  "devDependencies": {
    "babel-eslint": "^10.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jest": "^29.1.0",
    "jest": "^30.2.0",
    "jest-html-reporter": "^4.3.0",
    "jest-junit": "^16.0.0",
    "node-gyp": "^12.1.0",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4"
  },
  "dependenciesMeta": {
    "ngrok": {
      "built": false
    }
  }
}
